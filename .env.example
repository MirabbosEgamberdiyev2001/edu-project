# ═══════════════════════════════════════════════════════════════════════════════
# EduPlatform — Production Environment Variables Template
#
# This file is for DOCUMENTATION only. The actual values are stored as
# GitLab CI/CD Variables and written to /opt/eduplatform/.env on the server
# by the GitLab CI pipeline automatically.
#
# DO NOT commit .env files with real values to git.
# ═══════════════════════════════════════════════════════════════════════════════

# Docker images (set automatically by GitLab CI — do not change manually)
BACKEND_IMAGE=registry.gitlab.com/testprouz/edu-platform/backend:latest
FRONTEND_IMAGE=registry.gitlab.com/testprouz/edu-platform/frontend:latest

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=choose_a_strong_password_here

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters
# Generate with: openssl rand -base64 48
JWT_SECRET=your_random_jwt_secret_at_least_32_characters_long

# ── Frontend / CORS ───────────────────────────────────────────────────────────
# Set to your server IP or domain
FRONTEND_BASE_URL=http://62.84.186.113
CORS_ORIGINS=http://62.84.186.113

# ── OTP ───────────────────────────────────────────────────────────────────────
# false  = use real OTP (requires Eskiz SMS integration)
# true   = use fixed OTP 777777 (for testing only!)
APP_OTP_FIXED_ENABLED=false

# ── Mail (optional) ───────────────────────────────────────────────────────────
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
